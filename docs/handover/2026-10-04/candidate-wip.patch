+    release = "mouseReleased" if press == "mousePressed" else "keyUp"
+    assert sum(params.get("type") == release for _, params in inputs) == (0 if stop == "ambiguous" else 1)
+    assert all(method != "Input.insertText" for method, _ in inputs)
+    if stop != "ambiguous":
