+    clock, schedule, lock, calls = {"ms": 0}, [], threading.Lock(), []
+
+    def enabled(at, event):
+        network = [ms for method, ms in calls if method == "Network.enable"]
+        own = event["session_id"] == "S" and event["method"].startswith("Network.")
+        return not own or (network and at >= network[0])
+
+    def drain_events():
+        with lock:
+            due = [event for at, event in schedule if at <= clock["ms"] and enabled(at, event)]
+            schedule[:] = [(at, event) for at, event in schedule if at > clock["ms"]]
+        return due[-500:]
+
+    def at(ms, *events):
+        with lock:
+            schedule.extend((ms, event) for event in events)
+
+    def sleep(seconds):
+        clock["ms"] += round(seconds * 1000)
+
+    monkeypatch.setattr(browser, "time", SimpleNamespace(monotonic=lambda: clock["ms"] / 1000, sleep=sleep))
+    monkeypatch.setattr(browser, "drain_events", drain_events)
