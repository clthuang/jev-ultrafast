+def test_a_drain_that_fails_while_jev_decides_marks_the_wait_as_lost(tab, monkeypatch):
+    import jev_ultrafast.browser as browser
+
+    click(tab)
+    fake, failed = browser.drain_events, []
+
+    def timed_out():  # the daemon emptied its buffer, but its reply never came: those events are gone
+        failed.append(True)
+        raise TimeoutError("drain_events timed out after 5s waiting for the daemon")
+
+    monkeypatch.setattr(browser, "drain_events", timed_out)
+    with tab.browser.draining():
+        deadline = time.monotonic() + 2  # the real clock, as the drain thread's
+        while not failed and time.monotonic() < deadline:
+            time.sleep(0.005)
+    monkeypatch.setattr(browser, "drain_events", fake)
+    assert failed and tab.browser.wait_for_loading() == [0, False, True]
